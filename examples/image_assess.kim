-- Minimal multimodal generation example. Image pixels enter through an
-- explicit observation and stay local with this Ollama agent.

agent A:
    backend = "ollama"
    model   = "llava:13b"
    vision  = true

schema Assessment:
    text: text

context k_scene:
    domain     = "faithful description of what an image visibly shows"
    preserve   = [visible_content, counts]
    allow_loss = [style, emphasis]

photo := observe image("tests/fixtures/screen.png")
check photo.exists

-- gen with images is a priced read: one θ factor under read:k_scene.
a := gen<Assessment>("Describe only what is visibly present in this image.", images=[photo]) under k_scene by A

check len(a.text) > 0
commit(a)
