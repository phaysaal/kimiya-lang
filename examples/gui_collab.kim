-- Two-user collaboration, driven by looking at the screen.
--
-- This is the scenario a GUI-testing paper writes on the board: user A
-- creates a group, the join code is carried to user B, and the chat is
-- verified in both directions. Here it runs.
--
-- The two actors are declared displays. Here they are staged as two
-- monitors of one X screen — so they share one pointer, and the actor
-- names label intent rather than independence. Point B at another X
-- server (x11 = ":1") or another machine (ssh = "user@host") and the
-- same program drives two genuinely independent seats; the certificate
-- reports where each actor resolved either way.
--
-- The locator runs Opus 4.8 through the `claude` CLI — the same path the
-- seenslide GUI harness measured its datasheet through, which is why an
-- imported β≥.975 transfers to it rather than being an assertion.
--
-- Offline:  KIMIYA_MOCK=1 KIMIYA_SCREEN_FIXTURE=<png> kimiya run …

agent L:                          -- the locator: it has to see
    backend = "claude_cli"        -- headless Claude Code: no key, no SDK
    model   = "claude-opus-4-8"

agent J1:                         -- judge, family: anthropic
    backend = "claude_cli"
    model   = "claude-opus-4-8"

agent J2:                         -- judge, family: google  (J ⋪ C)
    backend = "openrouter"        -- one panel member must see differently:
    model   = "google/gemini-2.5-flash"   -- two Opus voters would be one
    key_env = "OPENROUTER_API_KEY"        -- pair of eyes certifying itself
    vision  = true

use python "collabdb.py"

display A:
    monitor = "eDP-1"

display B:
    monitor = "DP-1"

context k_ui:                     -- locating a described control
    domain     = "GUI control matching a description on a screenshot"
    preserve   = [role, visible_label, affordance]
    allow_loss = [pixel_position, theme, scale, unrelated_windows]

context k_state:                  -- judging an application state
    domain     = "whether a screenshot shows a described UI state"
    preserve   = [key_widgets, key_text, key_status]
    allow_loss = [cursor, clock, theme, unrelated_windows]

-- ---------------------------------------------------------------- A
a := observe screen<A>()
check a.exists

hits := select<0.97>("the + button by the groups heading", a) under k_ui by L
plus := first(hits)
act<A> screen.click(plus.x, plus.y)

a2 := observe screen<A>()
chits := select<0.97>("the Create Group button", a2) under k_ui by L
create := first(chits)
act<A> screen.click(create.x, create.y)
act<A> screen.type("W3 Harness Group")
act<A> screen.key("Return")

-- Settle on non-visual ground truth, not on a picture: the row either
-- exists or it does not, at certainty 1.
settle<A> until check group_exists("W3 Harness Group") within 12

a3 := observe screen<A>()
if judge<3,2/3> shows(a3, "a success view with an 8-character join code") under k_state panel [J1, J2]:
    print "A: group created"
else:
    abstain

-- The join code is read off A's screen: untrusted, and treated as such.
code := join_code("W3 Harness Group")
check len(code) == 8

-- ---------------------------------------------------------------- B
b := observe screen<B>()
check b.exists

bhits := select<0.97>("the + button by the groups heading", b) under k_ui by L
bplus := first(bhits)
act<B> screen.click(bplus.x, bplus.y)

b2 := observe screen<B>()
fhits := select<0.97>("the Join Code input", b2) under k_ui by L
field := first(fhits)
act<B> screen.click(field.x, field.y)
act<B> screen.type(code)
act<B> screen.key("Return")

settle<B> until check member_count("W3 Harness Group") == 2 within 12

-- ------------------------------------------------------------ verdict
-- Two gates. The kernel gate contributes no instrument error: any run
-- that commits satisfies it with certainty. The judged gate is an
-- instrument reading, and θ carries it at the locator's measured rate,
-- not at 1.
b3 := observe screen<B>()
if check(member_count("W3 Harness Group") == 2 and message_count("W3 Harness Group") == 2):
    if judge<3,2/3> shows(b3, "the chat pane displays the message sent by A") under k_state panel [J1, J2]:
        commit("W3 collaboration verified")
    else:
        abstain
else:
    abstain
