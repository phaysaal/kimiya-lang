-- Remote multimodal example. Kimiya announces prompt and pixel egress before
-- sending the observed image to this declared OpenRouter agent.

agent A:
    backend = "openrouter"
    model   = "google/gemini-2.5-flash"
    key_env = "OPENROUTER_API_KEY"
    vision  = true

schema Assessment:
    text: text

context k_scene:
    domain     = "faithful description of what an image visibly shows"
    preserve   = [visible_content, counts]
    allow_loss = [style, emphasis]

photo := observe image("tests/fixtures/screen.png")
check photo.exists
a := gen<Assessment>("Describe only what is visibly present.", images=[photo]) under k_scene by A
check len(a.text) > 0
commit(a)
